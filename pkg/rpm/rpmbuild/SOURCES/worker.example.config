{
	"applications": {
		"example_php": {
			"listen": "*:8300",
			"type": "php",
			"processes": 2,
			"root": "/usr/share/doc/worker-php/examples/phpinfo-app",
			"index": "index.php"
		},
		"example_python": {
			"listen": "*:8400",
			"type": "python",
			"processes": 2,
			"path": "/usr/share/doc/worker-python/examples/python-app",
			"module": "wsgi"
		},
		"example_go": {
			"listen": "*:8500",
			"type": "external",
			"executable": "/tmp/go-app"
		}
	}
}
